{
  "name": "@jixoai/casement",
  "version": "0.1.0",
  "description": "A React renderer that reconciles a declarative element tree onto OS windows and their view layers. First host: Electron (BaseWindow + WebContentsView).",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./electron": {
      "types": "./dist/host/electron/index.d.ts",
      "default": "./dist/host/electron/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "DESIGN.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-force-exit \"test/**/*.test.ts\"",
    "test:only": "node --test --test-force-exit",
    "check:dist": "node scripts/check-dist.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "react-reconciler": "^0.34.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-reconciler": "^0.34.1",
    "electron": "^45.0.0",
    "react": "^19.3.1",
    "typescript": "~5.9.3"
  }
}
